{
    "manifest_version": 2,
    "name": "Nabble Extension",
    "version": "1.1",
    "author": "DevelopmentLogics",
    "icons": {
        "128": "icon/Nablle.png"
    },
    "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/notification.js"
      ]
    }
  ],
    "background": {
        "persistent": true,
        "scripts" : ["background.js"]
    },
    "browser_action": {
        "default_icon": "icon/Nablle.png"
    },
    "permissions": [
      "geolocation",
        "activeTab",
        "notifications",
        "storage",
        "contextMenus"
    ]
    
}